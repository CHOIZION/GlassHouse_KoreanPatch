  {
    "id": 2937161072643,
    "text": "Talk reason into your opponent, de-escalate the situation.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072644,
    "text": "Attack your opponent, wield violence to defeat them.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072645,
    "text": "Use items to gain an advantage.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072646,
    "text": "ENEMY TURN",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072647,
    "text": "Your Health Points. If they get to 0, you die.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072648,
    "text": "Opponent's Health Points. If you lower them to 0, you will triumph with violence.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072649,
    "text": "Your Threat. If it is higher than your opponent's, you can attempt to Force Surrender.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072650,
    "text": "Your opponent's Threat. If it is lower than yours, you can attempt to Force Surrender.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072651,
    "text": "Attempt a Force Surrender roll. If successful, your opponent will surrender. Available only when your Threat is higher than your opponent's.",
    "metadata": {
      "m_Items": []
    }
  },
  {
    "id": 2937161072652,
    "text": "Force Surrender",
